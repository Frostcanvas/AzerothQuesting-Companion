<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AzerothQuestingCompanion</AssemblyName>
    <RootNamespace>AzerothQuesting.Companion</RootNamespace>
    <Version>0.1.9-beta.9</Version>
    <FileVersion>0.1.8.14</FileVersion>
    <AssemblyVersion>0.1.9.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AzerothQuesting.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Assets\AzerothQuesting.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
